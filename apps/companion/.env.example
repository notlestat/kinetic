# Optional. Only KINETIC_REBUILD_MODE=api reads this file's key; handoff and
# claude-cli modes need no API key. Copy to .env (which git ignores) and fill in.
ANTHROPIC_API_KEY=

# handoff (default) | claude-cli | api
# KINETIC_REBUILD_MODE=api
# Start a rebuild after each recording (claude-cli and api modes only).
# KINETIC_AUTO_REBUILD=1
# Overrides the api mode's model (default claude-opus-5-5).
# KINETIC_REBUILD_MODEL=
